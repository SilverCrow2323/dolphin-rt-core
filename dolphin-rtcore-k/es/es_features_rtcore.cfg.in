<?xml version="1.0"?>
<!-- Dolphin Rt:Core K - per-game options (generated by install.sh, do not edit by hand) -->
<features>
  <sharedFeatures>
    <feature name="CONTROLLER" value="rtc_pad" description="Stick layout used by the controller profiles.">
      <choice name="2 sticks" value="2" />
      <choice name="1 stick" value="1" />
      <choice name="No sticks" value="0" />
    </feature>
    <feature name="WIIMOTE POSITION" value="rtc_orient" description="Wii only. How the Wiimote is held.">
      <choice name="Upright" value="upright" />
      <choice name="Sideways" value="sideways" />
    </feature>
    <feature name="GAME SETTINGS" value="rtc_gamesettings" description="Apply the per-game .ini fixes shipped with the core.">
      <choice name="On" value="on" />
      <choice name="Off" value="off" />
    </feature>
    <feature name="SAFE EXIT" value="rtc_exit" description="Button combo that closes the game cleanly.">
      <choice name="Select + Start" value="select_start" />
      <choice name="Menu + Start" value="mode_start" />
    </feature>
    <feature name="HD TEXTURES" value="rtc_textures" description="Load custom textures from core/Load/Textures.">
      <choice name="Off" value="off" />
      <choice name="On" value="on" />
    </feature>
    <feature name="CHEATS" value="rtc_cheats" description="Enable cheat codes.">
      <choice name="Off" value="off" />
      <choice name="On" value="on" />
    </feature>
    <feature name="SHOW FPS" value="rtc_fps" description="Show the FPS counter.">
      <choice name="Off" value="off" />
      <choice name="On" value="on" />
    </feature>
  </sharedFeatures>
  <emulator name="rtcore-k" features="">
    <cores>
@CORES_FEATURES@
    </cores>
  </emulator>
</features>
