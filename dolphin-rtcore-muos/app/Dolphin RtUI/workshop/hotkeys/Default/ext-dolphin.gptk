# ============================================================
# Dolphin Rt:Core — gptokeyb2 keyboard hotkeys
# The pad continues to be available to Dolphin through SDL.
# No SELECT remapping/modifier: SELECT and START remain gameplay inputs.
# Format: button = key  |  button1+button2 = key
# ============================================================

# Multi-button hotkeys use L2 as a modifier.
l2+a       = F1     # Save State 1
l2+b       = F2     # Load State 1
l2+x       = F3     # Save State 2
l2+y       = F4     # Load State 2
l2+l1      = F5     # Save State 3
l2+r1      = F6     # Load State 3
l2+up      = F7     # Toggle Pause
l2+down    = F8     # Fast Forward
l2+left    = F9     # Frame Limit -
l2+right   = F10    # Frame Limit +
l2+r2      = F11    # Screenshot
l2+start   = F12    # Reset

