<?xml version="1.0"?>
<!-- Dolphin Rt:Core R - systems (generated by install.sh, do not edit by hand) -->
<systemList>
  <system>
    <name>wii</name>
    <fullname>Nintendo Wii</fullname>
    <manufacturer>Nintendo</manufacturer>
    <release>2006</release>
    <hardware>console</hardware>
    <path>@ROMS@/wii</path>
    <extension>.iso .ISO .wbfs .WBFS .rvz .RVZ .gcz .GCZ .wad .WAD .ciso .CISO .wia .WIA .dol .DOL .elf .ELF</extension>
    <command>"@ROOT@/bin/rtcore-r.sh" %ROM% %CORE%</command>
    <platform>wii</platform>
    <theme>wii</theme>
    <emulators>
      <emulator name="rtcore-r">
        <cores>
@CORES_SYSTEMS@
        </cores>
      </emulator>
    </emulators>
  </system>
  <system>
    <name>gamecube</name>
    <fullname>Nintendo GameCube</fullname>
    <manufacturer>Nintendo</manufacturer>
    <release>2001</release>
    <hardware>console</hardware>
    <path>@ROMS@/gamecube</path>
    <extension>.iso .ISO .gcm .GCM .gcz .GCZ .rvz .RVZ .ciso .CISO .tgc .TGC .dol .DOL .elf .ELF</extension>
    <command>"@ROOT@/bin/rtcore-r.sh" %ROM% %CORE%</command>
    <platform>gc</platform>
    <theme>gamecube</theme>
    <emulators>
      <emulator name="rtcore-r">
        <cores>
@CORES_SYSTEMS@
        </cores>
      </emulator>
    </emulators>
  </system>
</systemList>
